# Flask
LASTBITE_SECRET=
FLASK_DEBUG=false
PORT=5000

# Gemini (Google AI Studio). Keep server-side; never expose in frontend.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Elastic Cloud (optional; app uses SQLite fallback if omitted)
ELASTICSEARCH_URL=
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=
# PayPal Developer Sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_CURRENCY=USD
PAYPAL_RETURN_URL=http://127.0.0.1:5000/payments/return
PAYPAL_CANCEL_URL=http://127.0.0.1:5000/payments/cancel
PAYPAL_PLUS_PLAN_ID=
PAYPAL_FAMILY_PLAN_ID=
PAYPAL_SUBSCRIPTION_RETURN_URL=http://127.0.0.1:5000/subscriptions/return
